# Copy to .env for local development. Every variable is optional unless noted.
# Values are baked into the renderer bundle at build time, so never put a secret
# in a VITE_ variable you are not willing to ship to every user.

# WalletConnect / Reown project id (https://dashboard.reown.com). Needed for the web3 wallet connect button.
VITE_PROJECT_ID=

# Block52 indexer (hands, players, distribution). Defaults to https://indexer.block52.xyz
VITE_INDEXER_URL=

# Crypto deposit payment proxy. Defaults to the Block52 hosted proxy.
VITE_PAYMENT_PROXY_URL=

# Weekly Sit & Go schedule JSON. Defaults to the block52/ui repo's public/sng-schedule.json
VITE_SNG_SCHEDULE_URL=

# Treasury wallet address used for deposits.
VITE_TREASURY_WALLET_ADDRESS=

# NFT avatar picker needs ONE of these (otherwise the picker reports no NFT source):
#   a URL template with {owner} and {chainId} placeholders, or
VITE_PROFILE_NFT_INDEXER_URL=
#   an Alchemy mainnet RPC URL, e.g. https://eth-mainnet.g.alchemy.com/v2/<key> (treat as a secret)
VITE_MAINNET_RPC_URL=
